<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Life Reset OS</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-void: #07080A; 
    --bg-panel: #131519; 
    --bg-glass: rgba(19, 21, 25, 0.7);
    --accent-orange: #FF5E00;
    --text-primary: #F2F4F7; 
    --text-dim: #7C838F;
    --font-display: 'Rajdhani', sans-serif; 
    --font-body: 'Inter', sans-serif;
  }
  
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0; padding: 0; }
  body { background: var(--bg-void); color: var(--text-primary); font-family: var(--font-body); overflow-x: hidden; padding-bottom: 95px; }
  [hidden] { display: none !important; }

  #lock-screen { position: fixed; inset: 0; z-index: 500; background: var(--bg-void); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center; }
  .vault-title { font-family: var(--font-display); font-size: 36px; font-weight: 700; letter-spacing: 2px; margin-bottom: 8px; text-transform: uppercase; background: linear-gradient(90deg, #fff, #7C838F); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .vault-sub { font-size: 14px; color: var(--text-dim); margin-bottom: 40px; }
  
  .btn-primary { background: var(--accent-orange); color: #fff; border: none; padding: 14px 24px; border-radius: 12px; font-family: var(--font-body); font-weight: 600; font-size: 15px; cursor: pointer; box-shadow: 0 8px 24px rgba(255, 94, 0, 0.2); width: 100%; max-width: 300px; transition: transform 0.2s; }
  .btn-primary:active { transform: scale(0.96); }
  .btn-secondary { background: var(--bg-panel); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 14px 24px; border-radius: 12px; font-weight: 600; cursor: pointer; width: 100%; }

  .screen { padding: 20px; display: none; animation: fadeIn 0.3s ease; }
  .screen.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .day-tracker { font-family: var(--font-display); font-size: 28px; font-weight: 700; }
  .day-sub { color: var(--text-dim); font-size: 13px; font-weight: 500; }

  /* Audio Toggle Button */
  .audio-toggle { background: var(--bg-glass); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: 600; cursor: pointer; backdrop-filter: blur(5px); }
  .audio-toggle.playing { border-color: var(--accent-orange); color: var(--accent-orange); }

  #status-toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); background: var(--bg-glass); backdrop-filter: blur(10px); border: 1px solid var(--accent-orange); color: #fff; padding: 12px 20px; border-radius: 30px; font-size: 13px; font-weight: 600; z-index: 1000; display: none; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }

  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }
  .stat-card { background: var(--bg-glass); backdrop-filter: blur(12px); border-radius: 16px; padding: 16px; border: 1px solid rgba(255,255,255,0.05); }
  .stat-card.overall { background: linear-gradient(135deg, var(--accent-orange), #D64D00); border: none; box-shadow: 0 8px 20px rgba(255, 94, 0, 0.2); }
  .stat-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; opacity: 0.8; }
  .stat-val { font-size: 26px; font-weight: 700; font-family: var(--font-display); color: #fff; }

  .section-title { font-family: var(--font-display); font-size: 20px; font-weight: 700; margin-bottom: 16px; margin-top: 10px; }
  .task-input-box { display: flex; gap: 8px; margin-bottom: 20px; }
  .task-input { flex: 1; background: var(--bg-panel); border: 1px solid rgba(255,255,255,0.1); padding: 14px; border-radius: 12px; color: #fff; outline: none; }
  
  .task-card { background: var(--bg-panel); border-radius: 16px; padding: 16px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; border: 1px solid rgba(255,255,255,0.03); transition: opacity 0.3s; }
  .task-badge { font-size: 10px; padding: 4px 8px; border-radius: 6px; font-weight: 700; text-transform: uppercase; margin-bottom: 6px; display: inline-block; }
  .badge-day { background: rgba(255, 194, 75, 0.15); color: #FFC24B; }
  .badge-night { background: rgba(93, 169, 255, 0.15); color: #5DA9FF; }

  .day-sheet-card { background: var(--bg-panel); border-radius: 16px; padding: 16px; margin-bottom: 12px; border: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
  .day-sheet-info { display: flex; flex-direction: column; gap: 4px; }
  .status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
  .status-empty { background: #444; }
  .status-filled { background: #00E676; box-shadow: 0 0 10px rgba(0, 230, 118, 0.4); }

  #entry-modal { position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(10px); z-index: 400; display: flex; flex-direction: column; justify-content: flex-end; }
  .modal-content { background: var(--bg-panel); border-top-left-radius: 24px; border-top-right-radius: 24px; padding: 24px; height: 85vh; display: flex; flex-direction: column; border-top: 1px solid rgba(255,255,255,0.1); }
  .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  
  .diary-textarea { flex: 1; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 16px; color: #fff; font-family: var(--font-body); font-size: 15px; resize: none; outline: none; margin-bottom: 20px; line-height: 1.5; }
  
  .media-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
  .btn-record { background: #FF3B30; color: #fff; border: none; padding: 14px; border-radius: 12px; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 8px; }
  .video-preview-badge { text-align: center; font-size: 12px; color: #00E676; margin-bottom: 10px; font-weight: 600; }

  .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; height: 80px; background: rgba(19, 21, 25, 0.9); backdrop-filter: blur(20px); border-top: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-around; align-items: center; z-index: 200; padding-bottom: 10px; }
  .nav-item { background: none; border: none; color: var(--text-dim); font-size: 11px; font-weight: 600; display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px; }
  .nav-item.active { color: var(--accent-orange); }
  .nav-icon { font-size: 22px; }

  .voice-float { position: fixed; bottom: 100px; right: 20px; background: var(--accent-orange); color: #fff; width: 60px; height: 60px; border-radius: 50%; border: none; font-size: 24px; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 25px rgba(255,94,0,0.4); z-index: 250; cursor: pointer; }
  .voice-float.recording { animation: pulse 1s infinite; background: #FF3B30; box-shadow: 0 10px 25px rgba(255,59,48,0.4); }
  @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }
  
  #video-overlay { position: fixed; inset: 0; background: #000; z-index: 999; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  video { width: 100%; max-height: 85vh; object-fit: contain; }
</style>
</head>
<body>

  <div id="status-toast"></div>

  <!-- LOCK SCREEN -->
  <div id="lock-screen">
    <div class="vault-title">Life Reset OS</div>
    <div class="vault-sub">बहनचोद कायी हो जाएगा, करो.</div>
    <button class="btn-primary" id="btn-login">SYSTEM UPLINK</button>
  </div>

  <!-- SCREEN 1: DASHBOARD -->
  <div id="screen-dashboard" class="screen active">
    <!-- Cinematic Header with Background Video and Audio Toggle -->
    <div style="position: relative; width: 100%; border-radius: 16px; overflow: hidden; margin-bottom: 20px; border: 1px solid rgba(255,255,255,0.1);">
      <video src="onelife.mp4" autoplay loop muted playsinline style="width: 100%; height: 120px; object-fit: cover; filter: contrast(1.2); pointer-events: none;"></video>
      <div style="position: absolute; bottom: 12px; right: 12px;">
        <button id="audio-toggle-btn" class="audio-toggle" onclick="toggleAmbientAudio()">🔇 Ambient: OFF</button>
      </div>
    </div>

    <div class="header">
      <div>
        <div class="day-tracker" id="current-day-label">Day 1 / 60+</div>
        <div class="day-sub" id="user-greeting">System Active. Protocol Live.</div>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card overall">
        <div class="stat-title" style="color: #fff;">✦ Total XP</div>
        <div class="stat-val" id="xp-val">0</div>
      </div>
      <div class="stat-card">
        <div class="stat-title">🛡️ Rank</div>
        <div class="stat-val" id="rank-val" style="font-size: 20px; margin-top: 6px;">Novice</div>
      </div>
    </div>

    <div class="section-title">Architect Protocol</div>
    <div class="task-input-box">
      <input type="text" id="custom-task-text" class="task-input" placeholder="Enter protocol logic...">
      <select id="custom-task-type" class="task-input" style="flex: 0.4;">
        <option value="Day">Day</option>
        <option value="Night">Night</option>
      </select>
      <button class="btn-primary" style="width: auto; border-radius: 12px;" onclick="addCustomTask()">+</button>
    </div>

    <div class="section-title">Active Sequence</div>
    <div id="tasks-container"></div>
  </div>

  <!-- SCREEN 2: DATE SHEETS & DIARY -->
  <div id="screen-vault" class="screen">
    <div class="header">
      <div class="day-tracker">Chronicle Sheets</div>
      <div class="day-sub">Encrypted Video & Text Journals</div>
    </div>
    <div style="font-size: 13px; color: var(--text-dim); margin-bottom: 16px; line-height: 1.5;">
      Tap a Date Sheet below to write your daily reflections and lock in your video evidence.
    </div>
    <div id="chronological-days-container"></div>
  </div>

  <!-- SCREEN 3: SYSTEM -->
  <div id="screen-stats" class="screen">
    <div class="header">
      <div class="day-tracker">System Core</div>
      <div class="day-sub">Database Diagnostics</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Network Architecture</div>
      <div style="font-size: 13px; color: var(--text-dim); margin-top: 8px; line-height: 1.5;">
        • Drive Scope: AppDataFolder (Hidden Vault)<br>
        • Privacy Status: Invisible to Main Google Drive<br>
        • Firestore: Rules Unlocked (Test Mode)<br>
      </div>
    </div>
  </div>

  <!-- DIARY & VIDEO ENTRY MODAL -->
  <div id="entry-modal" hidden>
    <div class="modal-content">
      <div class="modal-header">
        <div class="day-tracker" id="modal-day-title">Day X</div>
        <button style="background:none; border:none; color:#fff; font-size:24px; font-weight:bold; cursor:pointer;" onclick="closeEntryModal()">×</button>
      </div>
      
      <div style="font-size: 12px; color: var(--text-dim); text-transform: uppercase; font-weight: 700; margin-bottom: 8px;">Captain's Log (Text Diary)</div>
      <textarea id="diary-text" class="diary-textarea" placeholder="Record your mindset, cravings, and reflections for today..."></textarea>
      
      <div id="video-status-text" class="video-preview-badge" hidden>✓ Video Locked In Memory</div>

      <div class="media-controls">
        <button class="btn-record" onclick="document.getElementById('camera-upload').click()">📷 Record Video</button>
        <button class="btn-secondary" onclick="document.getElementById('gallery-upload').click()">📁 Upload File</button>
      </div>
      
      <button class="btn-primary" style="max-width: 100%;" onclick="saveDayEntry()">Encrypt & Save Entry</button>
    </div>
  </div>

  <input type="file" id="camera-upload" accept="video/mp4,video/x-m4v,video/*" capture="user" hidden>
  <input type="file" id="gallery-upload" accept="video/mp4,video/*" hidden>

  <button class="voice-float" id="btn-mic">🎙️</button>

  <nav class="bottom-nav">
    <button class="nav-item active" onclick="switchScreen('dashboard', this)">
      <span class="nav-icon">⚡</span><span>Dashboard</span>
    </button>
    <button class="nav-item" onclick="switchScreen('vault', this)">
      <span class="nav-icon">📖</span><span>Date Sheets</span>
    </button>
    <button class="nav-item" onclick="switchScreen('stats', this)">
      <span class="nav-icon">⚙️</span><span>System</span>
    </button>
  </nav>

  <div id="video-overlay" hidden>
    <button class="btn-secondary" style="position: absolute; top: 40px; right: 20px; width: auto; z-index: 1000;" onclick="closeVideoPlayer()">Close Player</button>
    <video id="player" controls playsinline></video>
  </div>
  
  <!-- Ambient Audio Track -->
  <audio id="ambient-audio" src="onelife.mp4" loop preload="auto"></audio>

  <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getAuth, signInWithPopup, GoogleAuthProvider, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
    import { getFirestore, doc, setDoc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyAu4_pENf_CO_tqkk8FDiQ5atQi0-NlzyM",
      authDomain: "life-reset-91b0f.firebaseapp.com",
      projectId: "life-reset-91b0f",
      storageBucket: "life-reset-91b0f.firebasestorage.app",
      messagingSenderId: "581436413169",
      appId: "1:581436413169:web:d409ac80eaf18ee3cd4550"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);
    
    let googleAccessToken = null;
    let currentUser = null;
    let totalXP = 0;
    let userTasks = [];
    let entries = {}; 
    let activeModalDay = null;
    let pendingVideoFile = null; 
    let isAmbientPlaying = false;

    const toast = document.getElementById('status-toast');
    function showToast(text, duration = 3500) {
      toast.innerText = text;
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, duration);
    }

    // --- AMBIENT AUDIO LOGIC ---
    window.toggleAmbientAudio = function() {
      const audio = document.getElementById('ambient-audio');
      const btn = document.getElementById('audio-toggle-btn');
      
      if (isAmbientPlaying) {
        audio.pause();
        btn.innerText = "🔇 Ambient: OFF";
        btn.classList.remove('playing');
        isAmbientPlaying = false;
      } else {
        audio.volume = 0.5; // Background volume
        audio.play().then(() => {
          btn.innerText = "🔊 Ambient: ON";
          btn.classList.add('playing');
          isAmbientPlaying = true;
        }).catch(err => {
          showToast("Audio locked by browser. Tap screen first.");
        });
      }
    };

    window.switchScreen = function(screenName, btn) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      document.getElementById(`screen-${screenName}`).classList.add('active');
      btn.classList.add('active');
    };

    onAuthStateChanged(auth, async (user) => {
      if (user) {
        currentUser = user;
        document.getElementById('lock-screen').hidden = true;
        await loadUserData();
      }
    });

    document.getElementById('btn-login').addEventListener('click', async () => {
      const provider = new GoogleAuthProvider();
      provider.addScope('https://www.googleapis.com/auth/drive.appdata');
      try {
        const result = await signInWithPopup(auth, provider);
        googleAccessToken = GoogleAuthProvider.credentialFromResult(result).accessToken;
        currentUser = result.user;
        document.getElementById('lock-screen').hidden = true;
        await loadUserData();
      } catch (error) {
        alert("Uplink Failed. Check connection.");
      }
    });

    async function loadUserData() {
      if (!currentUser) return;
      try {
        const docSnap = await getDoc(doc(db, "users", currentUser.uid));
        if (docSnap.exists()) {
          const data = docSnap.data();
          totalXP = data.xp || 0;
          userTasks = data.tasks && data.tasks.length > 0 ? data.tasks : defaultTasks();
          entries = data.entries || {};
        } else {
          userTasks = defaultTasks();
          await setDoc(doc(db, "users", currentUser.uid), { xp: 0, tasks: userTasks, entries: {} });
        }
      } catch (e) {
        userTasks = defaultTasks();
        showToast("Offline Mode Active.");
      }
      updateDashboardUI();
      buildDateSheetsUI();
    }

    function defaultTasks() {
      return [
        { id: 1, text: "Wake up at 5 AM", type: "Day", done: false },
        { id: 2, text: "Journal mind state in Date Sheets", type: "Night", done: false }
      ];
    }

    function updateDashboardUI() {
      document.getElementById('xp-val').innerText = totalXP;
      const rank = totalXP > 1000 ? "Architect" : totalXP > 500 ? "Disciplined" : "Novice";
      document.getElementById('rank-val').innerText = rank;

      const container = document.getElementById('tasks-container');
      container.innerHTML = '';
      userTasks.forEach(task => {
        container.innerHTML += `
          <div class="task-card" style="opacity: ${task.done ? 0.4 : 1};">
            <div>
              <span class="task-badge ${task.type === 'Day' ? 'badge-day' : 'badge-night'}">${task.type}</span>
              <div style="font-weight: 500; font-size: 15px; text-decoration: ${task.done ? 'line-through' : 'none'};">${task.text}</div>
            </div>
            <button class="btn-primary" style="width: auto; padding: 8px 16px; border-radius: 10px;" onclick="toggleTask(${task.id})">${task.done ? '✓' : '+30'}</button>
          </div>
        `;
      });
    }

    window.addCustomTask = async function() {
      const textInput = document.getElementById('custom-task-text');
      const typeInput = document.getElementById('custom-task-type');
      if(!textInput.value.trim()) return;
      userTasks.push({ id: Date.now(), text: textInput.value.trim(), type: typeInput.value, done: false });
      textInput.value = '';
      updateDashboardUI();
      saveToCloud();
    };

    window.toggleTask = async function(id) {
      const task = userTasks.find(t => t.id === id);
      if(task && !task.done) {
        task.done = true;
        totalXP += 30;
        updateDashboardUI();
        saveToCloud();
      }
    };

    async function saveToCloud() {
      if(currentUser) await setDoc(doc(db, "users", currentUser.uid), { xp: totalXP, tasks: userTasks, entries }, { merge: true });
    }

    function buildDateSheetsUI() {
      const container = document.getElementById('chronological-days-container');
      container.innerHTML = '';
      
      for (let i = 1; i <= 60; i++) {
        const dayKey = `day-${i}`;
        const entry = entries[dayKey] || {};
        const isFilled = entry.text || entry.videoId;

        container.innerHTML += `
          <div class="day-sheet-card" onclick="openEntryModal(${i})">
            <div class="day-sheet-info">
              <div style="font-family: var(--font-display); font-weight: 700; font-size: 18px; color: #fff;">
                <span class="status-dot ${isFilled ? 'status-filled' : 'status-empty'}"></span> Day ${i}
              </div>
              <div style="font-size: 12px; color: var(--text-dim);">
                ${entry.text ? '📝 Journaled' : ''} ${entry.videoId ? ' 📹 Video Locked' : (isFilled ? '' : 'Tap to write log...')}
              </div>
            </div>
            ${entry.videoId ? `<button class="btn-secondary" style="width:auto; padding: 6px 12px;" onclick="event.stopPropagation(); streamVideo('${entry.videoId}')">Play</button>` : `<span style="color:var(--text-dim)">+</span>`}
          </div>
        `;
      }
    }

    window.openEntryModal = function(dayNum) {
      activeModalDay = `day-${dayNum}`;
      pendingVideoFile = null;
      document.getElementById('modal-day-title').innerText = `Date Sheet: Day ${dayNum}`;
      const existingEntry = entries[activeModalDay] || {};
      document.getElementById('diary-text').value = existingEntry.text || '';
      document.getElementById('video-status-text').hidden = true;
      document.getElementById('entry-modal').hidden = false;
    };

    window.closeEntryModal = function() {
      document.getElementById('entry-modal').hidden = true;
    };

    const handleFileSelect = (e) => {
      const file = e.target.files[0];
      if (file) {
        pendingVideoFile = file;
        document.getElementById('video-status-text').hidden = false;
        showToast("Video ready to lock in. Tap Save Entry.");
      }
    };
    document.getElementById('camera-upload').addEventListener('change', handleFileSelect);
    document.getElementById('gallery-upload').addEventListener('change', handleFileSelect);

    window.saveDayEntry = async function() {
      const textVal = document.getElementById('diary-text').value.trim();
      if (!entries[activeModalDay]) entries[activeModalDay] = {};
      entries[activeModalDay].text = textVal;
      document.getElementById('entry-modal').hidden = true;
      showToast("Encrypting entry...");

      if (pendingVideoFile && googleAccessToken) {
        const form = new FormData();
        form.append('metadata', new Blob([JSON.stringify({ name: `${activeModalDay}_log.mp4`, parents: ['appDataFolder'] })], { type: 'application/json' }));
        form.append('file', pendingVideoFile);

        try {
          const res = await fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart', {
            method: 'POST', headers: { 'Authorization': 'Bearer ' + googleAccessToken }, body: form
          });
          const data = await res.json();
          entries[activeModalDay].videoId = data.id;
          showToast(`Media & Journal locked into Vault.`);
        } catch (err) {
          showToast("Media upload failed, but journal text saved.");
        }
      } else {
        showToast("Journal text saved.");
      }
      
      await saveToCloud();
      buildDateSheetsUI();
    };

    window.streamVideo = async function(fileId) {
      if(!googleAccessToken) { alert("Session expired."); return; }
      
      // Auto-pause ambient audio when watching a diary video
      if(isAmbientPlaying) toggleAmbientAudio();

      document.getElementById('video-overlay').hidden = false;
      const player = document.getElementById('player');
      showToast("Decrypting media...");
      
      try {
        const res = await fetch(`https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`, {
          headers: { 'Authorization': 'Bearer ' + googleAccessToken }
        });
        const arrayBuffer = await res.arrayBuffer();
        const videoBlob = new Blob([arrayBuffer], { type: 'video/mp4' });
        
        if(player.src) URL.revokeObjectURL(player.src);
        player.src = URL.createObjectURL(videoBlob);
        player.muted = false;
        player.volume = 1.0;
        player.play().catch(e => showToast("Tap play manually."));
      } catch (err) {
        showToast("Stream failed.");
      }
    }

    window.closeVideoPlayer = function() {
      const player = document.getElementById('player');
      document.getElementById('video-overlay').hidden = true;
      player.pause();
      if(player.src) URL.revokeObjectURL(player.src);
    };

    const micBtn = document.getElementById('btn-mic');
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (SpeechRecognition) {
      const recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.lang = 'en-US';

      micBtn.addEventListener('click', () => {
        micBtn.classList.add('recording');
        showToast("Listening for intent...");
        recognition.start();
      });

      recognition.onresult = async (event) => {
        micBtn.classList.remove('recording');
        const transcript = event.results[0][0].transcript.toLowerCase();
        
        const triggers = ['pizza', 'mcdonald', 'burger', 'chocolate', 'cake', 'give up', 'quit'];
        if (triggers.some(word => transcript.includes(word))) {
           const allDays = Object.values(entries);
           const latestVideo = allDays.find(d => d.videoId);
           if(latestVideo) {
             streamVideo(latestVideo.videoId);
           } else {
             showToast("Craving detected! But no videos are in your Vault yet.");
           }
        } else {
          showToast(`System heard: "${transcript}"`);
        }
      };
      recognition.onerror = () => micBtn.classList.remove('recording');
    }
  </script>
</body>
</html>
